index 0000000..2f21121
--- /dev/null
+++ b/app/Madeira/LibraryDeckArtwork.swift
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Madeira Converter Exception: see LICENSE-EXCEPTION.md
+
+import SwiftUI
+import UIKit
+
+/// Uses the existing bounded, downsampled disk/memory cache. Wide Steam art
+/// gets its own cache key so it can never replace a portrait cover.
+struct LibraryDeckArtwork: View {
+    let source: LibraryCoverCache.Source?
+    @Environment(\.displayScale) private var scale
+    @State private var image: UIImage?
+
+    var body: some View {
+        GeometryReader { size in
+            ZStack {
+                LinearGradient(colors: [DeckLibraryPalette.surface, DeckLibraryPalette.background],
+                               startPoint: .topLeading, endPoint: .bottomTrailing)
+                if let image {
+                    Image(uiImage: image).resizable().scaledToFill()
+                        .frame(width: size.size.width, height: size.size.height).clipped()
+                } else {
+                    Image(systemName: "gamecontroller.fill").font(.largeTitle).foregroundStyle(.white.opacity(0.3))
+                }
+            }
+            .task(id: source) {
+                image = nil
+                load(width: size.size.width)
+            }
+            .task(id: Int(size.size.width * scale)) { load(width: size.size.width) }
+            .onReceive(LibraryCoverCache.shared.updates) { key in
+                if key == source?.key || key == source?.variant { load(width: size.size.width) }
+            }
+        }.accessibilityHidden(true)
+    }
+
+    private func load(width: CGFloat) {
+        guard let source else { return }
+        if let cached = LibraryCoverCache.shared.image(for: source, pixelWidth: Int(width * scale)) {
+            image = cached.image
+        }
+    }
+
+    @MainActor static func source(entry: LibraryEntry?, steamID: Int?, wide: Bool) -> LibraryCoverCache.Source? {
+        if let entry, entry.coverFile != nil { return .entry(entry) }
+        guard let id = steamID ?? entry?.steamID ?? entry?.steamAppID else {
+            return entry.flatMap { .entry($0) }
+        }
+        guard wide else { return .steam(id) }
+        var urls: [URL] = []
+        if let header = SteamOwnedLibrary.shared.game(id)?.headerImage, SteamGamesRules.safeAssetName(header),
+           let url = URL(string: SteamGamesRules.assetBase + "\(id)/" + header) { urls.append(url) }
+        if let url = URL(string: "https://cdn.cloudflare.steamstatic.com/steam/apps/\(id)/header.jpg") { urls.append(url) }
+        urls.append(contentsOf: SteamGamesRules.artwork(appID: id) { SteamOwnedLibrary.shared.game($0) })
+        return .init(key: "deck-wide-\(id)", urls: urls)
+    }
+}
diff --git a/tests/host/check-local-va-floor.py b/tests/host/check-local-va-floor.py
new file mode 100644
index 0000000..f302609
--- /dev/null
+++ b/tests/host/check-local-va-floor.py
@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+"""Compile the actual initialization function and preserve the deployed VA fix."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+source = (root / 'build/ntdll-unix/virtual_ios.c').read_text()
+start = source.index('void virtual_set_large_address_space(void)')
+function = source[start:source.index('\n}\n', start) + 3]
+prefix = r'''
+#include <assert.h>
+#include <stdint.h>
+typedef int BOOL;
+#define IMAGE_FILE_LARGE_ADDRESS_AWARE 0x20
+#define IMAGE_DLLCHARACTERISTICS_HIGH_ENTROPY_VA 0x20
+#define IMAGE_DLLCHARACTERISTICS_DYNAMIC_BASE 0x40
+static int is_win64, wow_value, note_count;
+static void *address_space_start, *user_space_limit, *working_set_limit;
+static void *address_space_limit = (void *)0x7fffffff0000ULL;
+static uintptr_t user_space_wow_limit, limit_4g = 0x100000000ULL, limit_2g = 0x80000000ULL;
+static struct { unsigned ImageCharacteristics, DllCharacteristics; } main_image_info;
+static uintptr_t ios_wow_base(void) { return wow_value ? 0x100000000ULL : 0; }
+static int is_wow64(void) { return wow_value; }
+static void free_reserved_memory(void *a, void *b) { (void)a; (void)b; }
+static uintptr_t ios_wow_ceiling_for_charact(unsigned c) { return c & 0x20 ? limit_4g - 1 : limit_2g - 1; }
+static void ios_wow_note_laa(unsigned c) { (void)c; note_count++; }
+static void ios_clamp_user_space_limit(const char *s) { (void)s; }
+'''
+main = r'''
+int main(void) {
+  uintptr_t starts[] = { 0x100010000ULL, 0x104e60000ULL, 0x110000ULL };
+  for (unsigned i = 0; i < 3; ++i)
+    for (int native = 0; native < 2; ++native)
+      for (int wow = 0; wow < 2; ++wow)
+        for (int laa = 0; laa < 2; ++laa) {
+          is_win64 = native; wow_value = wow; note_count = 0;
+          main_image_info.ImageCharacteristics = laa ? 0x20 : 0;
+          address_space_start = (void *)starts[i]; user_space_wow_limit = 123;
+          virtual_set_large_address_space();
+          uintptr_t expected = starts[i];
+#ifndef WINE_IOS
+          if (native && !wow) expected = 0x10000;
+#endif
+          assert((uintptr_t)address_space_start == expected);
+          assert(user_space_wow_limit == (native && wow ? (laa ? limit_4g : limit_2g) - 1 : 123));
+#ifdef WINE_IOS
+          assert(note_count == (native && wow ? 1 : 0));
+#endif
+        }
+}
+'''
+with tempfile.TemporaryDirectory() as folder:
+    path = Path(folder) / 'va.c'
+    path.write_text(prefix + function + main)
+    for flags in ([], ['-DWINE_IOS=1']):
+        exe = Path(folder) / ('ios' if flags else 'other')
+        subprocess.run(['cc', '-std=c11', '-O1', '-Wall', '-Werror', '-Wno-unused-function',
+                        '-Wno-unused-variable', *flags, str(path), '-o', str(exe)], check=True)
+        subprocess.run([str(exe)], check=True)
+print('PASS: native iOS keeps its initialized floor; WoW and other-platform behavior preserved (48 cases)')
diff --git a/tests/host/check-ios-runtime-compat.py b/tests/host/check-ios-runtime-compat.py
new file mode 100644
index 0000000..0eb1e09
--- /dev/null
+++ b/tests/host/check-ios-runtime-compat.py
@@ -0,0 +1,57 @@
+"""Check the linked iOS app and the bundled Wine OpenGL client."""
+from pathlib import Path
+import plistlib
+import re
+import runpy
+import struct
+import subprocess
+import sys
+from tempfile import TemporaryDirectory
+from zipfile import ZipFile
+
+
+def check_imports(ipa):
+    root = "Payload/Madeira.app/"
+    with ZipFile(ipa) as package, TemporaryDirectory() as directory:
+        # The upstream Wine iOS patch keeps x86 at its fixed base but lets
+        # ARM64EC load above 4 GB. A build missing the patch uses the same
+        # low base for both and can crash before a game creates its window.
+        for architecture, high in [("arm64ec-windows", True), ("i386-windows", False)]:
+            dll = package.read(root + architecture + "/opengl32.dll")
+            pe = struct.unpack_from("<I", dll, 0x3C)[0]
+            assert dll[pe:pe+4] == b"PE\0\0"
+            optional = pe + 24
+            magic = struct.unpack_from("<H", dll, optional)[0]
+            if high:
+                assert magic == 0x20B
+                base = struct.unpack_from("<Q", dll, optional + 24)[0]
+                assert base >= 2**32, f"{architecture}/opengl32.dll has low image base {base:#x}"
+            else:
+                assert magic == 0x10B
+                base = struct.unpack_from("<I", dll, optional + 28)[0]
+                assert base == 0x7A800000, f"{architecture}/opengl32.dll has unexpected image base {base:#x}"
+        # Loading shell controls during user32 initialization crashed both
+        # ParanormalHK and The Walking Dead before the first game window.
+        pe_reader = runpy.run_path(str(Path(__file__).resolve().parents[2] / "tools/check-wine-media-dlls.py"))["PE"]
+        for name, dependency in [("user32", "combase.dll"), ("shell32", "comctl32.dll"), ("comctl32", "winmm.dll")]:
+            data = package.read(root + f"arm64ec-windows/{name}.dll")
+            image = pe_reader(data, machines=(0x8664, 0xa641, 0xa64e, 0xaa64))
+            if dependency not in image.imports(delayed=True) or dependency in image.imports():
+                raise SystemExit(f"{name}.dll must delay loading {dependency}")
+        info = plistlib.loads(package.read(root + "Info.plist"))
+        executable = info["CFBundleExecutable"]
+        targets = [executable]
+        debug_library = executable + ".debug.dylib"
+        if root + debug_library in package.namelist():
+            targets.append(debug_library)
+        for name in targets:
+            binary = Path(directory) / name
+            binary.write_bytes(package.read(root + name))
+            imports = subprocess.check_output(["xcrun", "nm", "-u", str(binary)], text=True)
+            if re.search(r"\b_pipe2$", imports, re.MULTILINE):
+                raise SystemExit(f"{name} imports pipe2, which is absent on older iOS")
+            print(f"{name}: no pipe2 import")
+
+
+if __name__ == "__main__":
+    check_imports(sys.argv[1])
