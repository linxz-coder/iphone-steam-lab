@@ -8,6 +8,15 @@ export PATH="$MINGW:$PATH"
 
 [[ -x "$WINE/configure" ]] || { echo "ERROR: wine submodule is missing" >&2; exit 1; }
 
+# The native OpenGL thunks and the Windows DLL must come from the same
+# iOS-patched Wine tree (docs/BUILDING.md, OpenGL). This also applies when
+# rebuilding in an existing checkout that already has the patch.
+opengl_patch="$ROOT/patches/wine-opengl-winios.patch"
+if ! git -C "$WINE" apply --reverse --check "$opengl_patch" 2>/dev/null; then
+  git -C "$WINE" apply --check "$opengl_patch"
+  git -C "$WINE" apply "$opengl_patch"
+fi
