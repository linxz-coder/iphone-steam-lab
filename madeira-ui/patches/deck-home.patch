index 1307e2e..2ebe004 100755
--- a/build/windows-runtime/build.sh
+++ b/build/windows-runtime/build.sh
@@ -70,4 +70,21 @@ fi
 [ "$(git -C "$LUA" rev-parse HEAD)" = a4c064539ea931274d407e1249b4bb575424a0f4 ] || exit 1
 LUAJIT_SRC="$LUA" bash "$R/build/luajit-x64/build.sh"
 
+# These ARM64EC system modules are rebuilt with eager imports by build-modules.sh.
+# Keep the pinned release's delayed imports: on iOS 26.5.1, eagerly loading
+# the shell/COM stack can initialize common controls before win32u is ready.
+# Keep the rebuilt OpenGL client paired with the patched native runtime.
+release_commit=5fda6a0e9543e5de1df010aff35748ab913fd0d9
+release_dlls=(
+    WLDAP32 advapi32 combase comctl32 crypt32 cryptnet cryptowinrt cryptui
+    d3dx9_43 gdiplus hlink hnetcfg imm32 mfplat mfreadwrite mlang mmdevapi
+    ole32 oleaut32 rpcrt4 sechost secur32 setupapi shcore shell32 shlwapi
+    user32 uxtheme winhttp wininet winmm wintrust
+)
+for dll in "${release_dlls[@]}"; do
+    module="app/Madeira/arm64ec-windows/$dll.dll"
+    git -C "$R" show "$release_commit:$module" > "$R/$module.tmp"
+    mv "$R/$module.tmp" "$R/$module"
+done
+
 python3 "$R/build/windows-runtime/targets.py" closure
