+// SPDX-License-Identifier: GPL-3.0-or-later
+// Madeira Converter Exception: see LICENSE-EXCEPTION.md
+
+import SwiftUI
+
+/// Presentation only. The library owns installation, saves and launching.
+struct DeckLibraryGame: Identifiable, Equatable {
+    let id: String
+    var title: String
+    var subtitle: String
+    var lastPlayed: Date?
+}
+
+enum DeckLibraryPalette {
+    static let background = Color(red: 0.055, green: 0.083, blue: 0.115)
+    static let surface = Color(red: 0.17, green: 0.21, blue: 0.27)
+    static let accent = Color(red: 0.15, green: 0.72, blue: 0.96)
+    static let green = Color(red: 0.48, green: 0.79, blue: 0.20)
+}
+
+/// A Deck-style shelf: the selected game's wide artwork and neighbouring
+/// portrait covers. No display link, timer, video or animated background.
+struct DeckLibraryShelf<Artwork: View>: View {
+    let games: [DeckLibraryGame]
+    var title = "最近游玩"
+    let width: CGFloat
+    var viewportHeight: CGFloat = 900
+    @Binding var selection: String?
+    var open: (String) -> Void
+    var browse: () -> Void
+    @ViewBuilder var artwork: (DeckLibraryGame, Bool) -> Artwork
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+
+    private var active: DeckLibraryGame? {
+        games.first { $0.id == selection } ?? games.first
+    }
+    private var compactLandscape: Bool { width >= 600 && viewportHeight < 500 }
+    private var coverHeight: CGFloat {
+        if compactLandscape { return min(170, max(128, viewportHeight - 180)) }
+        return width < 600 ? min(210, max(140, width * 0.84 * 9 / 16)) : 232
+    }
+    private var featuredWidth: CGFloat { min(width - 12, coverHeight * 16 / 9) }
+    private var transition: Animation? { reduceMotion ? nil : .easeInOut(duration: 0.2) }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: compactLandscape ? 12 : 18) {
+            HStack(alignment: .firstTextBaseline) {
+                Text(title).font(.title2.bold())
+                Text("\(games.count)").font(.subheadline.monospacedDigit()).foregroundStyle(.white.opacity(0.5))
+                Spacer()
+                Button(action: browse) {
+                    Label("游戏库", systemImage: "arrow.right").font(.subheadline.weight(.semibold))
+                }.buttonStyle(.plain).foregroundStyle(DeckLibraryPalette.accent).frame(minHeight: 44)
+            }
+
+            if let active {
+                ScrollViewReader { reader in
+                    ScrollView(.horizontal, showsIndicators: false) {
+                        LazyHStack(alignment: .center, spacing: 14) {
+                            ForEach(games) { game in
+                                card(game, selected: game.id == active.id)
+                                    .id(game.id)
+                            }
+                        }.padding(6)
+                    }
+                    .frame(height: coverHeight + 12)
+                    .onAppear { reader.scrollTo(active.id, anchor: .leading) }
+                    .onChange(of: width) { _, _ in
+                        // Keep the selected cover visible after a rotation or split-view resize.
+                        reader.scrollTo(active.id, anchor: .leading)
+                    }
+                    .onChange(of: selection) { _, id in
+                        guard let id else { return }
+                        withAnimation(transition) { reader.scrollTo(id, anchor: .leading) }
+                    }
+                    .onChange(of: games.map(\.id)) { _, ids in
+                        if let selection, !ids.contains(selection) { self.selection = ids.first }
+                        if let id = self.selection ?? ids.first { reader.scrollTo(id, anchor: .leading) }
+                    }
+                }
+
+                HStack(alignment: .center, spacing: 14) {
+                    Button { open(active.id) } label: {
+                        Image(systemName: "arrow.up.right")
+                            .font(.title3.weight(.bold))
+                            .foregroundStyle(.black.opacity(0.8))
+                            .frame(width: 48, height: 48)
+                            .background(DeckLibraryPalette.green, in: RoundedRectangle(cornerRadius: 8))
+                    }.buttonStyle(.plain).accessibilityLabel("打开 \(active.title) 的游戏详情")
+                    VStack(alignment: .leading, spacing: 5) {
+                        Text(active.title).font(.title3.bold()).lineLimit(2).fixedSize(horizontal: false, vertical: true)
+                        Text(active.subtitle).font(.caption.weight(.semibold))
+                            .foregroundStyle(DeckLibraryPalette.green).lineLimit(2)
+                    }
+                    Spacer(minLength: 0)
+                    if width >= 600 {
+                        HStack(spacing: 8) {
+                            stepButton(-1, symbol: "chevron.left")
+                            stepButton(1, symbol: "chevron.right")
+                        }
+                    }
+                }.padding(.horizontal, 6)
+                if !compactLandscape {
+                    Text("点选封面切换 · 再点打开游戏详情")
+                        .font(.caption).foregroundStyle(.white.opacity(0.45)).padding(.horizontal, 6)
+                }
+            } else {
+                VStack(alignment: .leading, spacing: 10) {
+                    Label("还没有可展示的游戏", systemImage: "gamecontroller")
+                        .font(.headline)
+                    Text("在下方游戏库安装游戏，或调整搜索和平台筛选。")
+                        .font(.subheadline).foregroundStyle(.white.opacity(0.65))
+                }.frame(maxWidth: .infinity, alignment: .leading).padding(24)
+                    .background(DeckLibraryPalette.surface, in: RoundedRectangle(cornerRadius: 12))
+            }
+        }
+        .foregroundStyle(.white)
+    }
+
+    private func card(_ game: DeckLibraryGame, selected: Bool) -> some View {
+        Button {
+            if selected { open(game.id) }
+            else { withAnimation(transition) { selection = game.id } }
+        } label: {
+            artwork(game, selected)
+                .frame(width: selected ? featuredWidth : coverHeight * 2 / 3, height: coverHeight)
+                .clipped()
+                .clipShape(RoundedRectangle(cornerRadius: 10, style: .continuous))
+                .overlay {
+                    RoundedRectangle(cornerRadius: 10, style: .continuous)
+                        .strokeBorder(selected ? Color.white : Color.white.opacity(0.12), lineWidth: selected ? 3 : 1)
+                }
+                .shadow(color: .black.opacity(selected ? 0.35 : 0.18), radius: 4, y: 3)
+                .contentShape(RoundedRectangle(cornerRadius: 10))
+        }
+        .buttonStyle(.plain)
+        .accessibilityLabel(game.title)
+        .accessibilityValue(selected ? "已选中，\(game.subtitle)" : game.subtitle)
+        .accessibilityHint(selected ? "打开游戏详情" : "选中并展开封面")
+        .accessibilityAddTraits(selected ? [.isSelected] : [])
+    }
+
+    private func stepButton(_ direction: Int, symbol: String) -> some View {
+        Button {
+            guard !games.isEmpty else { return }
+            let current = games.firstIndex { $0.id == active?.id } ?? 0
+            let next = (current + direction + games.count) % games.count
+            withAnimation(transition) { selection = games[next].id }
+        } label: {
+            Image(systemName: symbol).font(.subheadline.bold()).frame(width: 44, height: 44)
+                .background(.white.opacity(0.08), in: RoundedRectangle(cornerRadius: 8))
+        }.buttonStyle(.plain).accessibilityLabel(direction < 0 ? "上一个游戏" : "下一个游戏")
+    }
+}
